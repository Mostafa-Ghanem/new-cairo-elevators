---
// Template for all product pages. Each src/content/products/<slug>.json becomes /<slug>
// (built as <slug>.html). Shared copy (process, related, form options, bottom CTA) is in
// src/data/product-shared.ts; the page CSS is src/styles/product-page.css.
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { PRODUCT_SHARED as S, PHONE, WHATSAPP_URL } from '../data/product-shared';
import productCss from '../styles/product-page.css?raw';

export async function getStaticPaths() {
  const products = await getCollection('products');
  return products.map((entry) => ({ params: { product: entry.id }, props: { p: entry.data } }));
}

const { p } = Astro.props;

type Img = { src: string; width: number; height: number; alt: string };
// Photos wider than 800px have a 720w sibling (<name>-720.webp) for phones.
const srcset = (img: Img) =>
  img.width > 800 ? `${img.src.replace(/\.webp$/, '-720.webp')} 720w, ${img.src} ${img.width}w` : undefined;
const SIZES = '(max-width: 820px) 40vw, 900px';

const nav = [
  ['#about', p.navAboutLabel],
  ...(p.video ? [['#video', 'فيديو من التنفيذ']] : []),
  ['#features', 'المميزات'],
  ['#suitable', 'الاستخدامات'],
  ['#decision', 'عوامل الاختيار'],
  ['#process', 'خطوات التنفيذ'],
  ['#faq', 'FAQ']
];
---
<BaseLayout title={p.title} description={p.description}>
<Fragment slot="head">
<style is:inline set:html={productCss}></style>
</Fragment>
<SiteHeader />
<main>
<div class="container breadcrumb"><a href="index.html">الرئيسية</a><span>›</span><a href="services.html">الخدمات والمنتجات</a><span>›</span>{p.breadcrumb}</div>
<section class="product-hero">
<div class="container">
<div class="hero-frame">
<div class="hero-copy">
<div class="kicker">{p.hero.kicker}</div>
<h1 set:html={p.hero.h1}></h1>
<p>{p.hero.lead}</p>
<div class="hero-actions">
<a class="btn btn-primary" href="#quote">
اطلب معاينة
<svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
</a>
<a class="btn btn-outline" href={WHATSAPP_URL} target="_blank" rel="noopener">تواصل على واتساب</a>
</div>
<div class="hero-points">
{p.hero.points.map((point) => <div class="hero-point"><i></i><span>{point}</span></div>)}
</div>
</div>
<div class="hero-media">
<img width={p.hero.image.width} height={p.hero.image.height} loading="eager" decoding="async" alt={p.hero.image.alt} src={p.hero.image.src} srcset={srcset(p.hero.image)} sizes={SIZES}>
<div class="hero-label">
<small>{S.labelSmall}</small>
<strong>{p.hero.labelStrong}</strong>
</div>
</div>
</div>
<div class="page-nav">
<div class="page-nav-inner">
{nav.map(([href, label]) => <a href={href}>{label}</a>)}
</div>
</div>
</div>
</section>
<section class="section pattern-grid">
<div class="container content-layout">
<article class="article">
<section class="article-section" id="about">
<div class="kicker">{p.about.kicker}</div>
<h2>{p.about.h2}</h2>
<p class="info-lead">{p.about.lead}</p>
<div class="how-grid">
<div class="tech-image">
<img width={p.about.image.width} height={p.about.image.height} loading="lazy" decoding="async" alt={p.about.image.alt} src={p.about.image.src} srcset={srcset(p.about.image)} sizes={SIZES}>
</div>
<div class="how-list">{p.about.items.map((item) => <div class="how-item"><div class="how-no">{item.no}</div><div><h3>{item.title}</h3><p>{item.text}</p></div></div>)}</div>
</div>
</section>
{p.video && (
<section class="article-section" id="video">
<div class="kicker">{S.videoKicker}</div>
<h2>{p.video.h2}</h2>
<p>{S.videoP}</p>
<div class={p.video.videos.length > 1 ? 'product-videos product-videos--2' : 'product-videos'}>
{p.video.videos.map((video) => (
<figure class="product-video">
<video controls playsinline preload="none" width={video.width} height={video.height} poster={video.poster} aria-label={video.label}>
<source src={video.src} type="video/mp4">
المتصفح عندك مش بيشغّل الفيديو. <a href={video.src}>حمّل الفيديو</a>.
</video>
<figcaption>{video.caption}</figcaption>
</figure>
))}
</div>
</section>
)}
<section class="article-section" id="features">
<div class="kicker">{p.features.kicker}</div>
<h2>{p.features.h2}</h2>
<p>{p.features.p}</p>
<div class="feature-grid">{p.features.items.map((item) => <div class="feature"><div class="feature-icon"><svg viewBox="0 0 24 24">{item.icon.map((d) => <path d={d}></path>)}</svg></div><div><h3>{item.title}</h3><p>{item.text}</p></div></div>)}</div>
<div class="inline-cta">
<div>
<h3>{p.features.cta.h3}</h3>
<p>{p.features.cta.p}</p>
</div>
<a class="btn btn-gold" href="#quote">{S.ctaButton}</a>
</div>
</section>
<section class="article-section" id="suitable">
<div class="kicker">{p.suitable.kicker}</div>
<h2>{p.suitable.h2}</h2>
<p>{p.suitable.p}</p>
<div class="use-grid">{p.suitable.items.map((item) => <div class="use-card"><span class="use-tag">{item.tag}</span><h3>{item.title}</h3><p>{item.text}</p></div>)}</div>
</section>
<section class="article-section" id="decision">
<div class="kicker">{p.decision.kicker}</div>
<h2>{p.decision.h2}</h2>
<p>{p.decision.p}</p>
<div class="factor-list">{p.decision.items.map((item) => <div class="factor"><div class="factor-no">{item.no}</div><div><h3>{item.title}</h3><p>{item.text}</p></div></div>)}</div>
</section>
<section class="article-section" id="process">
<div class="kicker">{S.process.kicker}</div>
<h2>{S.process.h2}</h2>
<p>{S.process.p}</p>
<div class="process-list">
{S.process.items.map((step) => <div class="process-step"><div class="process-dot">{step.no}</div><div><h3>{step.title}</h3><p>{step.text}</p></div></div>)}
</div>
</section>
<section class="article-section" id="faq">
<div class="kicker">{S.faqKicker}</div>
<h2>{p.faq.h2}</h2>
<div class="faq">{p.faq.items.map((item, i) => <details open={i === 0}><summary>{item.q}</summary><div class="answer">{item.a}</div></details>)}</div>
</section>
<section class="article-section">
<div class="kicker">{S.related.kicker}</div>
<h2>{S.related.h2}</h2>
<div class="related-grid">
{S.related.items.map((card) => (
<a class="related-card" href={card.href}>
<div class="related-img"><img width={card.image.width} height={card.image.height} loading="lazy" decoding="async" alt={card.image.alt} src={card.image.src} srcset={srcset(card.image)} sizes={SIZES}></div>
<div class="related-copy"><small>{card.small}</small><h3>{card.title}</h3><p>{card.text}</p></div>
</a>
))}
</div>
</section>
</article>
<aside class="form-card" id="quote">
<div class="form-top">
<div class="kicker">{S.form.kicker}</div>
<h3>{p.form.h3}</h3>
<p>{S.form.p}</p>
</div>
<form class="form-body" data-lead-form>
<input name="product" type="hidden" value={p.form.product}>
<div class="field">
<label for="name">الاسم</label>
<input id="name" name="name" placeholder="اكتب اسمك" required type="text">
</div>
<div class="field">
<label for="phone">رقم الموبايل</label>
<input id="phone" inputmode="tel" name="phone" placeholder="01xxxxxxxxx" required type="tel">
</div>
<div class="field">
<label for="project">نوع المشروع</label>
<select id="project" name="project" required>
{S.form.project.map((option, i) => i === 0 ? <option value="">{option}</option> : <option>{option}</option>)}
</select>
</div>
<div class="field">
<label for="floors">عدد الأدوار</label>
<select id="floors" name="floors">
{S.form.floors.map((option, i) => i === 0 ? <option value="">{option}</option> : <option>{option}</option>)}
</select>
</div>
<div class="field">
<label for="area">المنطقة</label>
<input id="area" name="area" placeholder={S.form.areaPlaceholder} type="text">
</div>
<div class="field">
<label for="notes">معلومة إضافية — اختياري</label>
<textarea id="notes" name="notes" placeholder={S.form.notesPlaceholder}></textarea>
</div>
<button class="btn btn-gold" type="submit">إرسال طلب المعاينة</button>
<p class="form-note" id="formMsg" data-form-status role="status" aria-live="polite">{S.form.note}</p>
<div class="form-contact">
<a class="mini-contact" href={`tel:${PHONE}`}>☎ {PHONE}</a>
<a class="mini-contact" href={WHATSAPP_URL} target="_blank" rel="noopener">واتساب مباشر</a>
</div>
</form>
</aside>
</div>
</section>
<section class="section-sm section-dark pattern-grid">
<div class="container">
<div class="bottom-cta">
<div>
<div class="kicker">{S.bottom.kicker}</div>
<h2>{S.bottom.h2}</h2>
<p>{S.bottom.p}</p>
</div>
<div class="bottom-actions">
<a class="btn btn-gold" href="#quote">اطلب معاينة</a>
<a class="btn btn-light" href={WHATSAPP_URL} target="_blank" rel="noopener">واتساب</a>
</div>
</div>
</div>
</section>
</main>
<SiteFooter />
<div class="mobile-actions">
<a class="btn btn-outline" href={`tel:${PHONE}`}>اتصال</a>
<a class="btn btn-primary" href={WHATSAPP_URL} target="_blank" rel="noopener">واتساب</a>
</div>
</BaseLayout>
