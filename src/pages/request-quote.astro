---
import BaseLayout from '../layouts/BaseLayout.astro';
import Img from '../components/Img.astro';
import contentCss from '../styles/content-page.css?raw';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
---
<BaseLayout title="طلب معاينة مصعد | القاهرة الجديدة للمصاعد"
  description="اطلب معاينة أو عرض سعر لمصعد جديد أو صيانة مصعد قائم. أرسل بيانات المبنى وسيتواصل معك فريق القاهرة الجديدة للمصاعد.">
<Fragment slot="head">
<style is:inline set:html={contentCss}></style>
</Fragment>
<SiteHeader /><main>
<div class="container breadcrumb"><a href="index.html">الرئيسية</a><span>›</span>طلب معاينة</div>
<section class="page-hero"><div class="container"><div class="hero-box">
<div class="hero-copy"><div class="kicker">طلب معاينة / عرض سعر</div><h1>كل اللي محتاجينه دلوقتي <span style="color:var(--champagne)">5 بيانات بسيطة.</span></h1><p>مش مطلوب تعرف نوع الماكينة أو المقاسات الفنية. ابعت بيانات المشروع الأساسية وفريق الشركة يتواصل معك لتحديد المعاينة والمعلومات الناقصة.</p></div>
<div class="hero-media"><Img src="assets/images/products/gearless-elevator/gallery-02.webp" width={960} height={1280} alt="طلب معاينة مصعد" loading="eager" /><div class="hero-label"><small>START YOUR PROJECT</small><strong>معاينة قبل الاختيار</strong></div></div>
</div></div></section>

<section class="section pattern"><div class="container contact-grid">
<div class="contact-panel"><div class="kicker">قبل ما تبعت</div><h2>إيه اللي يساعدنا نفهم الطلب؟</h2><p>نوع المبنى، عدد الأدوار، المنطقة وهل المشروع جديد أم مبنى قائم. لو عندك صور للموقع تقدر ترسلها بعد ذلك على واتساب.</p>
<div class="contact-list">
<div class="contact-item"><div class="icon"><svg viewBox="0 0 24 24"><path d="M4 20V8l8-4 8 4v12M8 20v-6h8v6"/></svg></div><div><b>نوع المبنى</b><span>فيلا، عمارة، تجاري، إداري أو منشأة طبية</span></div></div>
<div class="contact-item"><div class="icon"><svg viewBox="0 0 24 24"><path d="M7 20V4h10v16M4 20h16"/></svg></div><div><b>عدد الأدوار</b><span>رقم تقريبي كفاية في الأول</span></div></div>
<div class="contact-item"><div class="icon"><svg viewBox="0 0 24 24"><path d="M12 21s6-5.2 6-11a6 6 0 1 0-12 0c0 5.8 6 11 6 11Z"/></svg></div><div><b>المنطقة</b><span>عشان ننسق المعاينة ونتأكد إننا بنخدم منطقتك</span></div></div>
</div></div>

<form class="form-card" data-lead-form>
<div class="kicker">بيانات المشروع</div><h2>اطلب معاينة</h2>
<div class="form-grid">
<div class="field"><label for="f-1">الاسم</label><input id="f-1" required placeholder="اسمك"></div>
<div class="field"><label for="f-2">رقم الموبايل</label><input id="f-2" required type="tel" inputmode="tel" placeholder="01xxxxxxxxx"></div>
<div class="field"><label for="f-3">نوع المبنى</label><select id="f-3" required><option value="">اختار</option><option>فيلا</option><option>عمارة سكنية</option><option>تجاري / إداري</option><option>منشأة طبية</option><option>أخرى</option></select></div>
<div class="field"><label for="f-4">عدد الأدوار</label><select id="f-4"><option value="">اختار إن أمكن</option><option>2 - 4</option><option>5 - 8</option><option>9 أو أكثر</option><option>غير محدد</option></select></div>
<div class="field"><label for="f-5">نوع الطلب</label><select id="f-5" required><option value="">اختار</option><option>مصعد جديد</option><option>استبدال / تحديث</option><option>صيانة / عطل</option></select></div>
<div class="field"><label for="f-6">المنطقة</label><input id="f-6" placeholder="مثال: بيت الوطن"></div>
<div class="field full"><label for="f-7">ملاحظات — اختياري</label><textarea id="f-7" placeholder="أي تفاصيل عن البئر أو المبنى أو المصعد الحالي"></textarea></div>
</div>
<button class="btn btn-gold" style="width:100%;margin-top:14px">إرسال الطلب</button><p id="qmsg" data-form-status role="status" aria-live="polite" style="font-size:11px;margin:8px 0 0"></p>
</form>
</div></section>

<section class="section-sm section-soft"><div class="container"><div class="grid-3">
<div class="card"><div class="icon"><svg viewBox="0 0 24 24"><path d="M5 4h4l2 5-3 2a16 16 0 0 0 5 5l2-3 5 2v4"/></svg></div><h3>تحب تكلمنا؟</h3><p>01060781020</p></div>
<div class="card"><div class="icon"><svg viewBox="0 0 24 24"><path d="M20 11.5a8 8 0 0 1-11.8 7L4 20l1.5-4A8 8 0 1 1 20 11.5Z"/></svg></div><h3>واتساب</h3><p>01276611628</p></div>
<div class="card"><div class="icon"><svg viewBox="0 0 24 24"><path d="M12 21s6-5.2 6-11a6 6 0 1 0-12 0c0 5.8 6 11 6 11Z"/></svg></div><h3>المقر</h3><p>التجمع الأول، القاهرة الجديدة.</p></div>
</div></div></section>
</main>
<SiteFooter />
<div class="mobile-actions"><a class="btn btn-outline" href="tel:01060781020">اتصال</a><a class="btn btn-primary" href="https://wa.me/201276611628?text=%D8%A3%D9%87%D9%84%D9%8B%D8%A7%D8%8C%20%D8%B9%D8%A7%D9%8A%D8%B2%20%D8%A3%D8%B3%D8%AA%D9%81%D8%B3%D8%B1%20%D8%B9%D9%86%20%D9%85%D8%B5%D8%B9%D8%AF%20%D9%85%D9%86%20%D9%85%D9%88%D9%82%D8%B9%20%D8%A7%D9%84%D9%82%D8%A7%D9%87%D8%B1%D8%A9%20%D8%A7%D9%84%D8%AC%D8%AF%D9%8A%D8%AF%D8%A9%20%D9%84%D9%84%D9%85%D8%B5%D8%A7%D8%B9%D8%AF" target="_blank" rel="noopener">واتساب</a></div>
</BaseLayout>
