---
import BaseLayout from '../layouts/BaseLayout.astro';
import Img from '../components/Img.astro';
import contentCss from '../styles/content-page.css?raw';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
---
<BaseLayout title="مناطق خدمة المصاعد | القاهرة الجديدة للمصاعد"
  description="خدمات المصاعد في القاهرة الجديدة، بيت الوطن، التجمع، العاصمة الإدارية، الشيخ زايد ومناطق القاهرة مع إمكانية تنفيذ أعمال بالمحافظات.">
<Fragment slot="head">
<style is:inline set:html={contentCss}></style>
</Fragment>
<SiteHeader /><main>
<div class="container breadcrumb"><a href="index.html">الرئيسية</a><span>›</span>مناطق الخدمة</div>
<section class="page-hero"><div class="container"><div class="hero-box">
<div class="hero-copy"><div class="kicker">مناطق الخدمة</div><h1>شغلنا الأساسي في القاهرة والقاهرة الجديدة، <span style="color:var(--champagne)">وبنشتغل في المحافظات كمان.</span></h1><p>لو منطقتك مش في القائمة، ده مش معناه إننا مش بنخدمها. دي بس أبرز المناطق اللي بنشتغل فيها.</p>
<div class="hero-actions"><a class="btn btn-primary" href="request-quote.html">استفسر عن منطقتك</a><a class="btn btn-outline" href="https://wa.me/201276611628?text=%D8%A3%D9%87%D9%84%D9%8B%D8%A7%D8%8C%20%D8%B9%D8%A7%D9%8A%D8%B2%20%D8%A3%D8%B3%D8%AA%D9%81%D8%B3%D8%B1%20%D8%B9%D9%86%20%D9%85%D8%B5%D8%B9%D8%AF%20%D9%85%D9%86%20%D9%85%D9%88%D9%82%D8%B9%20%D8%A7%D9%84%D9%82%D8%A7%D9%87%D8%B1%D8%A9%20%D8%A7%D9%84%D8%AC%D8%AF%D9%8A%D8%AF%D8%A9%20%D9%84%D9%84%D9%85%D8%B5%D8%A7%D8%B9%D8%AF" target="_blank" rel="noopener">واتساب</a></div></div>
<div class="hero-media"><Img src="assets/images/products/gearless-elevator/gallery-02.webp" width={960} height={1280} alt="مناطق خدمة المصاعد" loading="eager" /><div class="hero-label"><small>LOCAL SERVICE</small><strong>القاهرة والقاهرة الجديدة</strong></div></div>
</div></div></section>

<section class="section pattern"><div class="container"><div class="section-head"><div><div class="kicker">أبرز المناطق</div><h2>بنخدم مشروعات في مناطق كتير.</h2></div><p>التنفيذ في الآخر بيعتمد على نوع المشروع وجدول الشغل، فالأفضل تكلمنا نأكدلك المعاينة في موقعك.</p></div>
<div class="area-cloud"><span class="area-chip">بيت الوطن</span><span class="area-chip">التجمع الأول</span><span class="area-chip">التجمع الثاني</span><span class="area-chip">جميع مناطق التجمع والقاهرة الجديدة</span><span class="area-chip">بيفرلي هيلز</span><span class="area-chip">العاصمة الإدارية الجديدة</span><span class="area-chip">كمبوند سراي</span><span class="area-chip">كمبوند لافيستا</span><span class="area-chip">الشيخ زايد</span><span class="area-chip">الأندلس</span><span class="area-chip">القاهرة عمومًا</span></div></div></section>

<section class="section section-soft"><div class="container grid-2" style="align-items:center"><div><div class="kicker">المقر</div><h2>مقرنا في التجمع الأول.</h2><p>عمارة 23 ب، التقسيم الجنوبي، محور السادات، التجمع الأول، القاهرة الجديدة.</p><p>ده يخلي القاهرة الجديدة نقطة انطلاق أساسية للخدمة، مع إمكانية تنفيذ أعمال في مناطق أخرى حسب المشروع.</p><a class="btn btn-primary" href="contact-us.html">بيانات التواصل</a></div><div class="map"><iframe loading="lazy" src="https://www.google.com/maps?q=%D8%B9%D9%85%D8%A7%D8%B1%D8%A9%2023%20%D8%A8%D8%8C%20%D8%A7%D9%84%D8%AA%D9%82%D8%B3%D9%8A%D9%85%20%D8%A7%D9%84%D8%AC%D9%86%D9%88%D8%A8%D9%8A%D8%8C%20%D9%85%D8%AD%D9%88%D8%B1%20%D8%A7%D9%84%D8%B3%D8%A7%D8%AF%D8%A7%D8%AA%D8%8C%20%D8%A7%D9%84%D8%AA%D8%AC%D9%85%D8%B9%20%D8%A7%D9%84%D8%A3%D9%88%D9%84%D8%8C%20%D8%A7%D9%84%D9%82%D8%A7%D9%87%D8%B1%D8%A9%20%D8%A7%D9%84%D8%AC%D8%AF%D9%8A%D8%AF%D8%A9&output=embed" title="مقر القاهرة الجديدة للمصاعد"></iframe></div></div></section>

<section class="section-sm"><div class="container"><div class="cta"><div><h2>منطقتك مش موجودة في القائمة؟</h2><p>ابعت اللوكيشن ونوع المشروع وهنأكدلك على طول.</p></div><div class="cta-actions"><a class="btn btn-gold" href="https://wa.me/201276611628?text=%D8%A3%D9%87%D9%84%D9%8B%D8%A7%D8%8C%20%D8%B9%D8%A7%D9%8A%D8%B2%20%D8%A3%D8%B3%D8%AA%D9%81%D8%B3%D8%B1%20%D8%B9%D9%86%20%D9%85%D8%B5%D8%B9%D8%AF%20%D9%85%D9%86%20%D9%85%D9%88%D9%82%D8%B9%20%D8%A7%D9%84%D9%82%D8%A7%D9%87%D8%B1%D8%A9%20%D8%A7%D9%84%D8%AC%D8%AF%D9%8A%D8%AF%D8%A9%20%D9%84%D9%84%D9%85%D8%B5%D8%A7%D8%B9%D8%AF" target="_blank" rel="noopener">واتساب</a><a class="btn btn-light" href="request-quote.html">طلب معاينة</a></div></div></div></section>
</main>
<SiteFooter />
<div class="mobile-actions"><a class="btn btn-outline" href="tel:01060781020">اتصال</a><a class="btn btn-primary" href="https://wa.me/201276611628?text=%D8%A3%D9%87%D9%84%D9%8B%D8%A7%D8%8C%20%D8%B9%D8%A7%D9%8A%D8%B2%20%D8%A3%D8%B3%D8%AA%D9%81%D8%B3%D8%B1%20%D8%B9%D9%86%20%D9%85%D8%B5%D8%B9%D8%AF%20%D9%85%D9%86%20%D9%85%D9%88%D9%82%D8%B9%20%D8%A7%D9%84%D9%82%D8%A7%D9%87%D8%B1%D8%A9%20%D8%A7%D9%84%D8%AC%D8%AF%D9%8A%D8%AF%D8%A9%20%D9%84%D9%84%D9%85%D8%B5%D8%A7%D8%B9%D8%AF" target="_blank" rel="noopener">واتساب</a></div>
</BaseLayout>
