---
import BaseLayout from '../layouts/BaseLayout.astro';
import Img from '../components/Img.astro';
import homeCss from '../styles/home.css?raw';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
---
<BaseLayout title="القاهرة الجديدة للمصاعد | توريد وتركيب وصيانة المصاعد"
  description="حلول مصاعد متكاملة للفيلات والمباني السكنية والتجارية: توريد، تركيب، تشطيب، صيانة وتحديث."
  preloadImage={{ href: '/assets/images/home/hero-luxury-elevator-lobby.avif', srcset: '/assets/images/home/hero-luxury-elevator-lobby-860.avif 860w, /assets/images/home/hero-luxury-elevator-lobby.avif 1122w', sizes: '(max-width: 900px) 60vw, 50vw' }}>
<Fragment slot="head">
<style is:inline set:html={homeCss}></style>
</Fragment>
<SiteHeader />

<main id="top">

<section class="hero pattern-host pattern-rails">
  <div class="container">
    <div class="hero-frame">
      <div class="hero-copy">
        <div class="kicker">حلول مصاعد هندسية متكاملة</div>
        <h1>مصعد يليق <span>بقيمة المبنى.</span></h1>
        <p>من المعاينة واختيار النظام، لحد التوريد والتركيب والتشطيب والصيانة. حلول مصاعد للفيلات والعمارات والمباني التجارية على حسب احتياج مشروعك الحقيقي.</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="#contact">
            احجز معاينة
            <svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
          <a class="btn btn-outline" href="#systems">استكشف أنظمة المصاعد</a>
        </div>

        <div class="hero-trust">
          <div><strong>20+</strong><span>عامًا من الخبرة في مجال المصاعد</span></div>
          <div><strong>8 حلول</strong><span>جيرلس، جيربوكس، هيدروليك بانوراما، خارجي، مستشفيات وصيانة</span></div>
          <div><strong>مسار واحد</strong><span>معاينة، توريد، تركيب، تشغيل ومتابعة</span></div>
        </div>
      </div>

      <div class="hero-media">
        <Img src="assets/images/home/hero-luxury-elevator-lobby.webp" width={1122} height={1402} alt="مدخل مصعد فاخر بأبواب ستانلس شامبين وكابينة رخام أونكس مضيء" loading="eager" fetchpriority="high" sizes="(max-width: 900px) 60vw, 50vw" />
        <div class="hero-badge">
          <div class="hero-badge-top">
            <b>Premium Elevator Solutions</b>
            <span class="gold-line"></span>
          </div>
          <p>الأمان والاعتمادية والتشطيب وراحة الاستخدام — كله بيتحسب من أول المشروع.</p>
        </div>
      </div>
    </div>

    <div class="credential-band">
      <div class="credential-grid">
        <div class="credential">
          <div class="line-icon"><svg viewBox="0 0 24 24"><path d="M4 20V8l8-4 8 4v12M8 20v-6h8v6"/></svg></div>
          <div><b>معاينة المشروع</b><span>قبل تحديد نوع المصعد</span></div>
        </div>
        <div class="credential">
          <div class="line-icon"><svg viewBox="0 0 24 24"><path d="M12 3v18M8 7l4-4 4 4M8 17l4 4 4-4"/></svg></div>
          <div><b>حلول متعددة</b><span>حسب المبنى والاستخدام</span></div>
        </div>
        <div class="credential">
          <div class="line-icon"><svg viewBox="0 0 24 24"><path d="M5 20V4h14v16M9 8h6M9 12h6M9 16h6"/></svg></div>
          <div><b>توريد وتركيب</b><span>حتى الاختبار والتشغيل</span></div>
        </div>
        <div class="credential">
          <div class="line-icon"><svg viewBox="0 0 24 24"><path d="M14 6a4 4 0 0 0-5.5 5.5L4 16l4 4 4.5-4.5A4 4 0 0 0 18 10l-3 3-4-4 3-3Z"/></svg></div>
          <div><b>صيانة ومتابعة</b><span>بعد التسليم والتشغيل</span></div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section pattern-host pattern-grid" id="services">
  <div class="container">
    <div class="section-head">
      <div>
        <div class="kicker">خدمات الشركة</div><div class="floor-motif" aria-hidden="true"><span></span><span class="active"></span><span></span><span></span></div>
        <h2>جهة واحدة لكل حاجة بدل ما تتعامل مع أكتر من حد.</h2>
      </div>
      <p>بنمسك المصعد من أول القرار الفني لحد التشغيل، ومركزين في التفاصيل اللي بتفرق في الاعتمادية والشكل النهائي.</p>
    </div>

    <div class="services-grid">
      <article class="service-large">
        <Img src="assets/images/products/gearless-elevator/gallery-03.webp" width={1200} height={1600} alt="توريد وتركيب المصاعد للمباني" />
        <div class="service-content">
          <div class="service-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M7 20V4h10v16M4 20h16M9 8h6M9 12h6M9 16h6"/></svg></div>
          <span class="number">01 — SUPPLY & INSTALLATION</span>
          <h3>توريد وتركيب المصاعد</h3>
          <p>بنختار النظام المناسب للمساحة وعدد الأدوار والاستخدام، وبعدها نورّد ونركّب ونختبر لحد التشغيل.</p>
          <a class="text-link" href="#contact">اطلب معاينة
            <svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
        </div>
      </article>

      <div class="service-side">
        <article class="service-small">
          <Img src="assets/images/products/hydraulic-panoramic-elevator/hero.webp" width={1086} height={1448} alt="تشطيبات وهوم ليفت للفيلات" />
          <div class="service-content">
            <div class="service-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 19 15 8l3 3L7 22H4v-3ZM14 5l2-2 5 5-2 2"/></svg></div>
            <span class="number">02 — CABIN & FINISH</span>
            <h3>الكبائن والتشطيبات</h3>
            <p>تصميم وتشطيب يليق بمبناك.</p>
            <a class="text-link" href="#projects">شاهد الاستخدامات ←</a>
          </div>
        </article>

        <article class="service-small">
          <Img src="assets/images/products/elevator-maintenance/hero.webp" width={1254} height={1254} alt="فني صيانة مصاعد" />
          <div class="service-content">
            <div class="service-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M14 6a4 4 0 0 0-5.5 5.5L4 16l4 4 4.5-4.5A4 4 0 0 0 18 10l-3 3-4-4 3-3Z"/></svg></div>
            <span class="number">03 — MAINTENANCE</span>
            <div class="product-head"><div class="premium-icon"><svg viewBox="0 0 24 24"><path d="M14 6a4 4 0 0 0-5.5 5.5L4 16l4 4 4.5-4.5A4 4 0 0 0 18 10l-3 3-4-4 3-3Z"/></svg></div><h3>الصيانة والتحديث</h3></div>
            <p>متابعة بتقلل الأعطال وبتحافظ على الأداء.</p>
            <a class="text-link" href="#maintenance">خدمة الصيانة ←</a>
          </div>
        </article>
      </div>
    </div>
  </div>
</section>

<div class="container"><div class="pattern-divider" aria-hidden="true"></div></div>

<section class="section section-soft pattern-host pattern-rails" id="systems">
  <div class="container">
    <div class="section-head">
      <div>
        <div class="kicker">أنظمة المصاعد المتاحة</div>
        <div class="floor-motif" aria-hidden="true"><span></span><span class="active"></span><span></span><span></span></div>
        <h2>بنختار نوع المصعد حسب المبنى والاستخدام.</h2>
      </div>
      <p>عندنا حلول للمستشفيات والواجهات الخارجية والعمارات والمباني التجارية والفيلات. والمعاينة هي اللي بتحدد الأنسب قبل التوريد.</p>
    </div>

    <div class="product-list">

      <a class="product-card" href="hospital-elevator.html">
        <div class="product-image">
          <Img src="assets/images/products/hospital-elevator/hero.webp" width={1024} height={1536} alt="مصعد مستشفيات" />
        </div>
        <div class="product-copy">
          <div class="product-meta">HOSPITAL ELEVATOR</div>
          <div class="product-head">
            <div class="premium-icon gold"><svg viewBox="0 0 24 24"><path d="M5 20V5h14v15M9 8h6M12 5v6M9 8h6M8 14h8M8 17h8"/></svg></div>
            <h3>مصعد مستشفيات</h3>
          </div>
          <p>حل للمستشفيات والمنشآت الطبية بيراعي مساحة الكابينة وسهولة الحركة والاعتمادية والضغط اليومي.</p>
        </div>
        <div class="product-action"><span><svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></div>
      </a>

      <a class="product-card" href="outdoor-elevator.html">
        <div class="product-image">
          <Img src="assets/images/products/outdoor-elevator/hero.webp" width={1086} height={1448} alt="مصعد خارجي" />
        </div>
        <div class="product-copy">
          <div class="product-meta">OUTDOOR ELEVATOR</div>
          <div class="product-head">
            <div class="premium-icon"><svg viewBox="0 0 24 24"><path d="M4 20V7l8-4 8 4v13M8 20V9h8v11M12 9v11"/></svg></div>
            <h3>مصعد خارجي</h3>
          </div>
          <p>حل للمباني اللي محتاجة مصعد من برّه، بعد دراسة الواجهة والمساحة والتنفيذ.</p>
        </div>
        <div class="product-action"><span><svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></div>
      </a>

      <a class="product-card" href="gearbox-elevator.html">
        <div class="product-image">
          <Img src="assets/images/products/gearbox-elevator/hero.webp" width={1086} height={1448} alt="مصعد جيربوكس" />
        </div>
        <div class="product-copy">
          <div class="product-meta">GEARED / GEARBOX ELEVATOR</div>
          <div class="product-head">
            <div class="premium-icon gold"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M5 5l2 2M17 17l2 2M19 5l-2 2M7 17l-2 2"/></svg></div>
            <h3>مصعد جيربوكس</h3>
          </div>
          <p>حل كهربائي عملي ومعروف للعمارات والمباني التجارية، والمواصفات بتتحدد حسب ارتفاع المبنى والحمولة.</p>
        </div>
        <div class="product-action"><span><svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></div>
      </a>

      <a class="product-card" href="gearbox-automatic-doors.html">
        <div class="product-image">
          <Img src="assets/images/products/gearbox-automatic-doors/hero.webp" width={1086} height={1448} alt="مصعد جيربوكس أبواب أوتوماتيك" />
        </div>
        <div class="product-copy">
          <div class="product-meta">GEARBOX + AUTOMATIC DOORS</div>
          <div class="product-head">
            <div class="premium-icon"><svg viewBox="0 0 24 24"><path d="M4 20V4h16v16M12 4v16M8 12h1M15 12h1"/></svg></div>
            <h3>مصعد جيربوكس أبواب أوتوماتيك</h3>
          </div>
          <p>جيربوكس مع أبواب أوتوماتيك، راحة أكتر وشكل أشيك للعمارات والمباني التجارية.</p>
        </div>
        <div class="product-action"><span><svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></div>
      </a>

      <a class="product-card" href="electric-elevator.html">
        <div class="product-image">
          <Img src="assets/images/products/electric-elevator/hero.webp" width={1024} height={1536} alt="مصعد كهرباء" />
        </div>
        <div class="product-copy">
          <div class="product-meta">ELECTRIC ELEVATOR</div>
          <div class="product-head">
            <div class="premium-icon gold"><svg viewBox="0 0 24 24"><path d="M13 2 6 13h5l-1 9 8-12h-5l0-8Z"/></svg></div>
            <h3>مصعد كهرباء</h3>
          </div>
          <p>مصاعد كهرباء للعمارات والمباني التجارية، ونوع الماكينة والمواصفات بيتحددوا حسب المشروع.</p>
        </div>
        <div class="product-action"><span><svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></div>
      </a>

      <a class="product-card" href="hydraulic-panoramic-elevator.html">
        <div class="product-image">
          <Img src="assets/images/products/hydraulic-panoramic-elevator/hero.webp" width={1086} height={1448} alt="مصعد هيدروليك بانوراما" />
        </div>
        <div class="product-copy">
          <div class="product-meta">PANORAMIC HYDRAULIC</div>
          <div class="product-head">
            <div class="premium-icon"><svg viewBox="0 0 24 24"><path d="M5 20V4h14v16M8 7h8v10H8zM12 7v10"/></svg></div>
            <h3>مصعد هيدروليك بانوراما</h3>
          </div>
          <p>شكل مميز للفيلات والمشروعات اللي بتهتم بالواجهة، بنظام هيدروليك وتشطيب بانوراما.</p>
        </div>
        <div class="product-action"><span><svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></div>
      </a>

      <a class="product-card" href="gearless-elevator.html">
        <div class="product-image">
          <Img src="assets/images/products/gearless-elevator/gallery-01.webp" width={960} height={1280} alt="مصعد جيرلس" />
        </div>
        <div class="product-copy">
          <div class="product-meta">GEARLESS ELEVATOR</div>
          <div class="product-head">
            <div class="premium-icon gold"><svg viewBox="0 0 24 24"><path d="M7 20V4h10v16M4 20h16M9.5 7h5v10h-5M12 4V2"/></svg></div>
            <h3>مصعد جيرلس</h3>
          </div>
          <p>حل حديث حركته ناعمة وكفاءته عالية، مناسب للمشروعات اللي عايزة مصعد أهدى وأحدث.</p>
        </div>
        <div class="product-action"><span><svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></div>
      </a>

    </div>
  </div>
</section>

<section class="section pattern-host pattern-grid" id="why">
  <div class="container why-wrap">
    <div class="why-media">
      <Img src="assets/images/products/gearless-elevator/gallery-05.webp" width={1200} height={1600} alt="مصعد منزلي زجاج فاخر" />
      <div class="experience-card">
        <strong>20+</strong>
        <span>عامًا من الخبرة في مجال المصاعد</span>
      </div>
    </div>

    <div>
      <div class="kicker">لماذا القاهرة الجديدة للمصاعد؟</div><div class="floor-motif" aria-hidden="true"><span></span><span class="active"></span><span></span><span></span></div>
      <h2>الجودة مش في شكل الكابينة وبس.</h2>
      <p>الجودة بتبدأ من اختيار النظام الصح، وبعدين التنفيذ والاختبار، وبتكمل في خدمة ما بعد البيع والصيانة.</p>

      <div class="why-list">
        <div class="why-item">
          <div class="why-num">01</div>
          <div><h3>اختيار هندسي قبل البيع</h3><p>بنبدأ من احتياج مشروعك، مش بنفرض عليك حل واحد لكل الناس.</p></div>
        </div>
        <div class="why-item">
          <div class="why-num">02</div>
          <div><h3>تنفيذ منظم وواضح</h3><p>مراحل واضحة من المعاينة والتجهيز لحد الاختبار والتسليم.</p></div>
        </div>
        <div class="why-item">
          <div class="why-num">03</div>
          <div><h3>تشطيب يليق بالمكان</h3><p>بنهتم إن المصعد يكون مريح وشكله لايق على المبنى.</p></div>
        </div>
        <div class="why-item">
          <div class="why-num">04</div>
          <div><h3>الصيانة جزء من الحل</h3><p>قيمة المصعد بتكمل بعد التسليم بالتشغيل المستقر والمتابعة.</p></div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section process pattern-host pattern-grid" id="process">
  <div class="container process-grid">
    <div class="process-intro">
      <div class="kicker">طريقة العمل</div>
      <h2>خطوات واضحة من أول معاينة لحد التشغيل.</h2>
      <p>مش عايزينك تتوه في تفاصيل كتير. كل مرحلة ليها هدف ونتيجة واضحة قبل ما ننتقل للي بعدها.</p>
    </div>

    <div class="process-steps">
      <div class="process-step">
        <div class="process-no">01</div>
        <div><h3>معاينة المشروع</h3><p>بنحدد المساحة وعدد الأدوار والاستخدام واحتياجاتك الأساسية.</p></div>
        <svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </div>
      <div class="process-step">
        <div class="process-no">02</div>
        <div><h3>اختيار النظام والعرض</h3><p>بنحدد الحل المناسب ونتفق على المواصفات قبل التنفيذ.</p></div>
        <svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </div>
      <div class="process-step">
        <div class="process-no">03</div>
        <div><h3>التوريد والتركيب</h3><p>بنجهز المكونات ونركّب ونظبط في الموقع.</p></div>
        <svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </div>
      <div class="process-step">
        <div class="process-no">04</div>
        <div><h3>الاختبار والتسليم</h3><p>بنختبر التشغيل ونسلّم، ونحدد الصيانة والمتابعة المطلوبة.</p></div>
        <svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </div>
    </div>
  </div>
</section>

<section class="section pattern-host pattern-rails" id="projects">
  <div class="container">
    <div class="section-head">
      <div>
        <div class="kicker">المشروعات والاستخدامات</div><div class="floor-motif" aria-hidden="true"><span></span><span class="active"></span><span></span><span></span></div>
        <h2>حل المصعد بيتغير حسب المكان.</h2>
      </div>
      <p>الفيلا أولوياتها غير العمارة وغير المبنى التجاري، عشان كده بنختار النظام والتشطيب حسب الاستخدام الحقيقي.</p>
    </div>

    <div class="gallery-grid">
      <div class="gallery-item">
        <Img src="assets/images/products/gearless-elevator/gallery-03.webp" width={1200} height={1600} alt="مصعد داخل فيلا" />
        <div class="gallery-label"><b>فيلات ومنازل خاصة</b><span>HOME & VILLA</span></div>
      </div>
      <div class="gallery-item">
        <Img src="assets/images/products/gearless-elevator/gallery-08.webp" width={1200} height={1600} alt="مصاعد مبنى تجاري" />
        <div class="gallery-label"><b>مبانٍ تجارية وإدارية</b><span>COMMERCIAL</span></div>
      </div>
      <div class="gallery-item">
        <Img src="assets/images/products/gearless-elevator/gallery-05.webp" width={1200} height={1600} alt="مصعد زجاج حديث" />
        <div class="gallery-label"><b>مشروعات فاخرة</b><span>PREMIUM FINISH</span></div>
      </div>
      <div class="gallery-item">
        <Img src="assets/images/products/gearless-elevator/gallery-09.webp" width={1200} height={1600} alt="مصاعد عمارات سكنية" />
        <div class="gallery-label"><b>عمارات سكنية</b><span>RESIDENTIAL</span></div>
      </div>
      <div class="gallery-item">
        <Img src="assets/images/products/hydraulic-panoramic-elevator/hero.webp" width={1086} height={1448} alt="هوم ليفت" />
        <div class="gallery-label"><b>Home Lifts</b><span>PRIVATE HOMES</span></div>
      </div>
    </div>
  </div>
</section>

<section class="section-sm section-soft" id="maintenance">
  <div class="container">
    <div class="maintenance-card">
      <div class="maintenance-media">
        <Img src="assets/images/products/elevator-maintenance/hero.webp" width={1254} height={1254} alt="فني يقوم بصيانة مصعد" />
      </div>

      <div class="maintenance-copy">
        <div class="kicker">الصيانة وخدمة ما بعد البيع</div>
