# Cloudflare Pages cache rules (free). Asset URLs are versioned (?v=) or content-stable,
# so browsers can reuse them instead of re-checking on every page view.
/assets/images/*
  Cache-Control: public, max-age=2592000
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/assets/videos/*
  Cache-Control: public, max-age=2592000
/assets/css/*
  Cache-Control: public, max-age=604800
/assets/js/*
  Cache-Control: public, max-age=604800
/favicon.ico
  Cache-Control: public, max-age=604800
/favicon-32.png
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
