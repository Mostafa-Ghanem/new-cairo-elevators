---
import BaseLayout from '../layouts/BaseLayout.astro';
import Img from '../components/Img.astro';
import contentCss from '../styles/content-page.css?raw';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
---
<BaseLayout title="خدمات المصاعد | القاهرة الجديدة للمصاعد"
  description="توريد وتركيب وصيانة جميع أنواع المصاعد: جيرلس، جيربوكس، كهرباء، هيدروليك بانوراما، مصاعد مستشفيات وخارجية.">
<Fragment slot="head">
<style is:inline set:html={contentCss}></style>
</Fragment>
<SiteHeader /><main>
<div class="container breadcrumb"><a href="index.html">الرئيسية</a><span>›</span>خدماتنا</div>
<section class="page-hero"><div class="container"><div class="hero-box">
<div class="hero-copy"><div class="kicker">خدماتنا</div><h1>حلول مصاعد متكاملة <span style="color:var(--champagne)">من المعاينة لحد الصيانة.</span></h1><p>بنورّد كل أنواع المصاعد ونركبها ونشغلها، وبنصين المصاعد الموجودة. وبنحدد الحل حسب المبنى والاستخدام، مش نفس النظام لكل الناس.</p>
<div class="hero-actions"><a class="btn btn-primary" href="request-quote.html">اطلب معاينة</a><a class="btn btn-outline" href="https://wa.me/201276611628?text=%D8%A3%D9%87%D9%84%D9%8B%D8%A7%D8%8C%20%D8%B9%D8%A7%D9%8A%D8%B2%20%D8%A3%D8%B3%D8%AA%D9%81%D8%B3%D8%B1%20%D8%B9%D9%86%20%D9%85%D8%B5%D8%B9%D8%AF%20%D9%85%D9%86%20%D9%85%D9%88%D9%82%D8%B9%20%D8%A7%D9%84%D9%82%D8%A7%D9%87%D8%B1%D8%A9%20%D8%A7%D9%84%D8%AC%D8%AF%D9%8A%D8%AF%D8%A9%20%D9%84%D9%84%D9%85%D8%B5%D8%A7%D8%B9%D8%AF" target="_blank" rel="noopener">واتساب</a></div></div>
<div class="hero-media"><Img src="assets/images/products/gearless-elevator/gallery-02.webp" width={960} height={1280} alt="خدمات المصاعد" loading="eager" /><div class="hero-label"><small>OUR SERVICES</small><strong>Supply • Installation • Maintenance</strong></div></div>
</div></div></section>

<section class="section pattern"><div class="container"><div class="section-head"><div><div class="kicker">الأنواع والخدمات</div><h2>اختار الصفحة الأقرب لاحتياجك.</h2></div><p>لو مش عارف نوع المصعد المناسب، متحتارش دلوقتي. اطلب معاينة وإحنا نحدد النظام بعد ما نراجع بيانات مشروعك.</p></div>
<div class="grid-2"><a class="service-card" href="hospital-elevator.html"><Img src="assets/images/products/hospital-elevator/hero.webp" width={1024} height={1536} alt="مصعد مستشفيات" /><div class="service-copy"><small>HOSPITAL</small><h3>مصعد مستشفيات</h3><p>حلول للمنشآت الطبية بتراعي حركة المرضى والسراير والأجهزة.</p><span class="text-link">اعرف التفاصيل ←</span></div></a><a class="service-card" href="outdoor-elevator.html"><Img src="assets/images/products/outdoor-elevator/hero.webp" width={1086} height={1448} alt="مصعد خارجي" /><div class="service-copy"><small>OUTDOOR</small><h3>مصعد خارجي</h3><p>مصعد من برّه المبنى لو الواجهة والمساحة يسمحوا.</p><span class="text-link">اعرف التفاصيل ←</span></div></a><a class="service-card" href="gearbox-elevator.html"><Img src="assets/images/products/gearbox-elevator/hero.webp" width={1086} height={1448} alt="مصعد جيربوكس" /><div class="service-copy"><small>GEARBOX</small><h3>مصعد جيربوكس</h3><p>حل جر كهربائي عملي للمباني السكنية والتجارية.</p><span class="text-link">اعرف التفاصيل ←</span></div></a><a class="service-card" href="gearbox-automatic-doors.html"><Img src="assets/images/products/gearbox-automatic-doors/hero.webp" width={1086} height={1448} alt="جيربوكس أبواب أوتوماتيك" /><div class="service-copy"><small>AUTO DOORS</small><h3>جيربوكس أبواب أوتوماتيك</h3><p>تجربة استخدام أكثر راحة مع أبواب أوتوماتيك.</p><span class="text-link">اعرف التفاصيل ←</span></div></a><a class="service-card" href="electric-elevator.html"><Img src="assets/images/products/electric-elevator/hero.webp" width={1024} height={1536} alt="مصعد كهرباءء" /><div class="service-copy"><small>ELECTRIC</small><h3>مصعد كهرباء</h3><p>حلول كهرباء كتير حسب عدد الأدوار والاستخدام.</p><span class="text-link">اعرف التفاصيل ←</span></div></a><a class="service-card" href="hydraulic-panoramic-elevator.html"><Img src="assets/images/products/hydraulic-panoramic-elevator/hero.webp" width={1086} height={1448} alt="هيدروليك بانوراما" /><div class="service-copy"><small>PANORAMIC</small><h3>هيدروليك بانوراما</h3><p>حركة هيدروليك وتصميم بانوراما للفيلات والمشروعات المميزة.</p><span class="text-link">اعرف التفاصيل ←</span></div></a><a class="service-card" href="gearless-elevator.html"><Img src="assets/images/products/gearless-elevator/gallery-01.webp" width={960} height={1280} alt="مصعد جيرلس" /><div class="service-copy"><small>GEARLESS</small><h3>مصعد جيرلس</h3><p>هدوء وسلاسة وكفاءة تشغيل ضمن نظام جر حديث.</p><span class="text-link">اعرف التفاصيل ←</span></div></a><a class="service-card" href="elevator-maintenance.html"><Img src="assets/images/products/elevator-maintenance/hero.webp" width={1254} height={1254} alt="صيانة وإصلاح المصاعد" /><div class="service-copy"><small>MAINTENANCE</small><h3>صيانة وإصلاح المصاعد</h3><p>فحص وتشخيص وصيانة ومتابعة للمصاعد الموجودة.</p><span class="text-link">اعرف التفاصيل ←</span></div></a></div></div></section>

<section class="section section-soft"><div class="container"><div class="section-head"><div><div class="kicker">بنشتغل إزاي؟</div><h2>5 مراحل واضحة.</h2></div><p>الخطوات ثابتة أيًا كان نوع المصعد، والتفاصيل الفنية بس هي اللي بتختلف.</p></div>
<div class="process-list">
<div class="process-item"><div class="process-no">01</div><div><h3>استشارة أولية</h3><p>بنعرف نوع المبنى وعدد الأدوار واحتياجك.</p></div></div>
<div class="process-item"><div class="process-no">02</div><div><h3>معاينة الموقع</h3><p>زيارة للموقع نقيس فيها ونشوف ظروف التنفيذ.</p></div></div>
<div class="process-item"><div class="process-no">03</div><div><h3>العرض الفني والمالي</h3><p>بنحدد النظام والمكونات والتشطيب وخطة التنفيذ.</p></div></div>
<div class="process-item"><div class="process-no">04</div><div><h3>التوريد والتركيب</h3><p>بننفذ الشغل والتوصيلات والظبط.</p></div></div>
<div class="process-item"><div class="process-no">05</div><div><h3>التشغيل والصيانة</h3><p>بنختبر ونسلّم المصعد، ونحدد المتابعة الدورية.</p></div></div>
</div></div></section>

<section class="section-sm"><div class="container"><div class="cta"><div><h2>مش عارف تبدأ من أي نوع؟</h2><p>ابعت نوع المبنى وعدد الأدوار وهنكلمك نحدد ميعاد المعاينة.</p></div><div class="cta-actions"><a class="btn btn-gold" href="request-quote.html">اطلب معاينة</a><a class="btn btn-light" href="tel:01060781020">كلمنا دلوقتي</a></div></div></div></section>
</main>
<SiteFooter />
<div class="mobile-actions"><a class="btn btn-outline" href="tel:01060781020">اتصال</a><a class="btn btn-primary" href="https://wa.me/201276611628?text=%D8%A3%D9%87%D9%84%D9%8B%D8%A7%D8%8C%20%D8%B9%D8%A7%D9%8A%D8%B2%20%D8%A3%D8%B3%D8%AA%D9%81%D8%B3%D8%B1%20%D8%B9%D9%86%20%D9%85%D8%B5%D8%B9%D8%AF%20%D9%85%D9%86%20%D9%85%D9%88%D9%82%D8%B9%20%D8%A7%D9%84%D9%82%D8%A7%D9%87%D8%B1%D8%A9%20%D8%A7%D9%84%D8%AC%D8%AF%D9%8A%D8%AF%D8%A9%20%D9%84%D9%84%D9%85%D8%B5%D8%A7%D8%B9%D8%AF" target="_blank" rel="noopener">واتساب</a></div>
</BaseLayout>
