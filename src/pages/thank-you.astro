---
import BaseLayout from '../layouts/BaseLayout.astro';
import contentCss from '../styles/content-page.css?raw';
import thankYouCss from '../styles/thank-you.css?raw';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
---
<BaseLayout title="وصلنا طلبك | القاهرة الجديدة للمصاعد"
  description="شكرًا لتواصلك مع القاهرة الجديدة للمصاعد."
  robots="noindex, nofollow">
<Fragment slot="head">
<style is:inline set:html={contentCss + thankYouCss}></style>
</Fragment>
<SiteHeader /><main>
<section class="thanks"><div class="container">
<div class="thanks-check" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg></div>
<div class="kicker">شكرًا لثقتك</div>
<h1>وصلنا طلبك ✓</h1>
<p>فريقنا هيراجع بيانات مشروعك وهيكلمك في أقرب وقت عشان نحدد ميعاد المعاينة. لو عايز الرد يبقى أسرع، أكّد طلبك على واتساب وابعت صور للموقع لو معاك.</p>
<div class="hero-actions" style="justify-content:center">
<a class="btn btn-gold" id="thanksWhatsapp" href="https://wa.me/201276611628?text=%D8%A3%D9%87%D9%84%D9%8B%D8%A7%D8%8C%20%D8%B9%D8%A7%D9%8A%D8%B2%20%D8%A3%D8%B3%D8%AA%D9%81%D8%B3%D8%B1%20%D8%B9%D9%86%20%D9%85%D8%B5%D8%B9%D8%AF%20%D9%85%D9%86%20%D9%85%D9%88%D9%82%D8%B9%20%D8%A7%D9%84%D9%82%D8%A7%D9%87%D8%B1%D8%A9%20%D8%A7%D9%84%D8%AC%D8%AF%D9%8A%D8%AF%D8%A9%20%D9%84%D9%84%D9%85%D8%B5%D8%A7%D8%B9%D8%AF" target="_blank" rel="noopener">أكّد طلبك على واتساب</a>
<a class="btn btn-outline" href="tel:01060781020">كلمنا دلوقتي: 01060781020</a>
</div>
<div class="process-list thanks-steps">
<div class="process-item"><div class="process-no">1</div><div><h3>هنكلمك</h3><p>واحد من فريقنا هيتواصل معاك على الرقم اللي كتبته عشان يفهم احتياجك.</p></div></div>
<div class="process-item"><div class="process-no">2</div><div><h3>نحدد ميعاد المعاينة</h3><p>بنزور الموقع ونقيس البئر والمساحة ونشوف التجهيزات على الطبيعة.</p></div></div>
<div class="process-item"><div class="process-no">3</div><div><h3>تستلم العرض</h3><p>عرض فني ومالي واضح بالنظام والمواصفات المناسبة لمبناك.</p></div></div>
</div>
<div class="hero-actions" style="justify-content:center;margin-top:28px"><a class="btn btn-primary" href="services.html">شوف أنواع المصاعد</a><a class="btn btn-outline" href="faq.html">الأسئلة الشائعة</a></div>
</div></section>
</main>
<SiteFooter />
<div class="mobile-actions"><a class="btn btn-outline" href="tel:01060781020">اتصال</a><a class="btn btn-primary" href="https://wa.me/201276611628?text=%D8%A3%D9%87%D9%84%D9%8B%D8%A7%D8%8C%20%D8%B9%D8%A7%D9%8A%D8%B2%20%D8%A3%D8%B3%D8%AA%D9%81%D8%B3%D8%B1%20%D8%B9%D9%86%20%D9%85%D8%B5%D8%B9%D8%AF%20%D9%85%D9%86%20%D9%85%D9%88%D9%82%D8%B9%20%D8%A7%D9%84%D9%82%D8%A7%D9%87%D8%B1%D8%A9%20%D8%A7%D9%84%D8%AC%D8%AF%D9%8A%D8%AF%D8%A9%20%D9%84%D9%84%D9%85%D8%B5%D8%A7%D8%B9%D8%AF" target="_blank" rel="noopener">واتساب</a></div>
<script is:inline>
(function () {
  // Prefilled WhatsApp message saved by assets/js/lead-form.js before redirecting here.
  try {
    var url = sessionStorage.getItem('nce_lead_whatsapp');
    if (url) document.getElementById('thanksWhatsapp').href = url;
  } catch (e) {}
  // Conversion event for Google Ads / GA4 / Meta Pixel when their tags are installed.
  window.dataLayer = window.dataLayer || [];
  window.dataLayer.push({ event: 'generate_lead' });
  if (typeof window.gtag === 'function') window.gtag('event', 'generate_lead');
  if (typeof window.fbq === 'function') window.fbq('track', 'Lead');
})();
</script>
</BaseLayout>
