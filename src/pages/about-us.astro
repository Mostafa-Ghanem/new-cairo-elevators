---
import BaseLayout from '../layouts/BaseLayout.astro';
import contentCss from '../styles/content-page.css?raw';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
---
<BaseLayout title="من نحن | القاهرة الجديدة للمصاعد"
  description="تعرف على شركة القاهرة الجديدة للمصاعد وخدمات توريد وتركيب وصيانة جميع أنواع المصاعد في القاهرة والقاهرة الجديدة.">
<Fragment slot="head">
<style is:inline set:html={contentCss}></style>
</Fragment>
<SiteHeader /><main>
<div class="container breadcrumb"><a href="index.html">الرئيسية</a><span>›</span>من نحن</div>
<section class="page-hero"><div class="container"><div class="hero-box">
<div class="hero-copy"><div class="kicker">من نحن</div><h1>شركة متخصصة في <span style="color:var(--champagne)">توريد وتركيب وصيانة المصاعد.</span></h1>
<p>في القاهرة الجديدة للمصاعد بنقدم حلول للعمارات والمباني التجارية والفيلات والمنشآت المختلفة، وتركيزنا على إننا نختار النظام الصح لمشروعك، وننفذ بجودة وضمان وسرعة.</p>
<div class="hero-actions"><a class="btn btn-primary" href="request-quote.html">اطلب معاينة</a><a class="btn btn-outline" href="services.html">شاهد خدماتنا</a></div></div>
<div class="hero-media"><img width="960" height="1280" loading="eager" decoding="async" src="assets/images/products/gearless-elevator/gallery-02.webp" srcset="assets/images/products/gearless-elevator/gallery-02-720.webp 720w, assets/images/products/gearless-elevator/gallery-02.webp 960w" sizes="(max-width: 820px) 40vw, 900px" alt="مصاعد حديثة"><div class="hero-label"><small>NEW CAIRO ELEVATORS</small><strong>توريد • تركيب • صيانة</strong></div></div>
</div></div></section>

<section class="section pattern"><div class="container">
<div class="section-head"><div><div class="kicker">طريقتنا في العمل</div><h2>إحنا مش بنبدأ من نوع المصعد.. بنبدأ من المبنى نفسه.</h2></div>
<p>المساحة وعدد الأدوار وطريقة الاستخدام والحمولة والأبواب والتجهيزات الموجودة هي اللي بتحدد الحل المناسب. عشان كده المعاينة دايمًا قبل أي قرار فني.</p></div>
<div class="grid-4">
<div class="card"><div class="icon"><svg viewBox="0 0 24 24"><path d="M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20M8 12l3 3 5-6"/></svg></div><h3>الجودة</h3><p>بنختار المكونات وننفذها على حسب مشروعك واحتياجات التشغيل.</p></div>
<div class="card"><div class="icon"><svg viewBox="0 0 24 24"><path d="M12 3 5 6v5c0 5 3 8 7 10 4-2 7-5 7-10V6l-7-3Z"/></svg></div><h3>الضمان</h3><p>الضمان جزء أساسي من كل عرض بنقدمه ومن الاتفاق على المشروع.</p></div>
<div class="card"><div class="icon"><svg viewBox="0 0 24 24"><path d="M5 20V4h14v16M9 8h6M9 12h6M9 16h6"/></svg></div><h3>الخبرة</h3><p>اشتغلنا على أنواع كتير من المصاعد والمباني وظروف مواقع مختلفة.</p></div>
<div class="card"><div class="icon"><svg viewBox="0 0 24 24"><path d="M12 3v9l5 3M12 22a10 10 0 1 0 0-20"/></svg></div><h3>سرعة التنفيذ</h3><p>بننظم خطوات المشروع وجدول التنفيذ بشكل واضح من الأول.</p></div>
</div>
</div></section>

<section class="section section-soft"><div class="container grid-2" style="align-items:center">
<div class="image-card"><img width="1200" height="1600" loading="lazy" decoding="async" src="assets/images/products/gearless-elevator/gallery-03.webp" srcset="assets/images/products/gearless-elevator/gallery-03-720.webp 720w, assets/images/products/gearless-elevator/gallery-03.webp 1200w" sizes="(max-width: 820px) 40vw, 900px" alt="مصعد داخل فيلا"></div>
<div><div class="kicker">نطاق أعمالنا</div><h2>من الفيلا لحد المبنى التجاري.</h2><p>بنورّد ونركّب ونصين كل أنواع المصاعد، وعندنا حلول مخصوصة للمنشآت الطبية والمباني القديمة والمشروعات الجديدة. شغلنا الأساسي في القاهرة والقاهرة الجديدة، وممكن نشتغل في المحافظات حسب المشروع.</p>
<div class="area-cloud" style="margin-top:20px"><span class="area-chip">فيلات</span><span class="area-chip">عمارات سكنية</span><span class="area-chip">مبانٍ إدارية</span><span class="area-chip">مبانٍ تجارية</span><span class="area-chip">منشآت طبية</span><span class="area-chip">مشروعات قائمة وجديدة</span></div>
</div></div></section>

<section class="section-sm"><div class="container"><div class="cta"><div><div class="kicker">ابدأ من المعاينة</div><h2>عندك مشروع جديد أو مصعد قائم؟</h2><p>ابعتلنا بيانات المشروع الأساسية ونحدد معاك الخطوة الجاية.</p></div><div class="cta-actions"><a class="btn btn-gold" href="request-quote.html">طلب معاينة</a><a class="btn btn-light" href="https://wa.me/201276611628?text=%D8%A3%D9%87%D9%84%D9%8B%D8%A7%D8%8C%20%D8%B9%D8%A7%D9%8A%D8%B2%20%D8%A3%D8%B3%D8%AA%D9%81%D8%B3%D8%B1%20%D8%B9%D9%86%20%D9%85%D8%B5%D8%B9%D8%AF%20%D9%85%D9%86%20%D9%85%D9%88%D9%82%D8%B9%20%D8%A7%D9%84%D9%82%D8%A7%D9%87%D8%B1%D8%A9%20%D8%A7%D9%84%D8%AC%D8%AF%D9%8A%D8%AF%D8%A9%20%D9%84%D9%84%D9%85%D8%B5%D8%A7%D8%B9%D8%AF" target="_blank" rel="noopener">واتساب</a></div></div></div></section>
</main>
<SiteFooter />
<div class="mobile-actions"><a class="btn btn-outline" href="tel:01060781020">اتصال</a><a class="btn btn-primary" href="https://wa.me/201276611628?text=%D8%A3%D9%87%D9%84%D9%8B%D8%A7%D8%8C%20%D8%B9%D8%A7%D9%8A%D8%B2%20%D8%A3%D8%B3%D8%AA%D9%81%D8%B3%D8%B1%20%D8%B9%D9%86%20%D9%85%D8%B5%D8%B9%D8%AF%20%D9%85%D9%86%20%D9%85%D9%88%D9%82%D8%B9%20%D8%A7%D9%84%D9%82%D8%A7%D9%87%D8%B1%D8%A9%20%D8%A7%D9%84%D8%AC%D8%AF%D9%8A%D8%AF%D8%A9%20%D9%84%D9%84%D9%85%D8%B5%D8%A7%D8%B9%D8%AF" target="_blank" rel="noopener">واتساب</a></div>
</BaseLayout>
