---
// Shared <html>/<head> shell for every page: meta, preloads, global CSS, canonical/OG/Twitter
// and JSON-LD. Pages pass their own <style is:inline> through the "head" slot and their body
// markup through the default slot.
import { SITE_NAME, INTERNAL_PAGES, slugFromPath, cleanUrl, ogImage, structuredData } from '../lib/site';
import globalCssRaw from '../../public/assets/css/global.css?raw';

interface Props {
  title: string;
  description?: string;
  /** e.g. "noindex, nofollow" */
  robots?: string;
  viewport?: string;
  /** null omits the tag */
  themeColor?: string | null;
  /** Load global.css before the page's own styles instead of after (design-system-preview). */
  globalCssFirst?: boolean;
  /** LCP image preload: { href, srcset, sizes } */
  preloadImage?: { href: string; srcset: string; sizes: string };
}

const {
  title,
  description,
  robots,
  viewport = 'width=device-width, initial-scale=1, viewport-fit=cover',
  themeColor = '#0A1724',
  globalCssFirst = false,
  preloadImage
} = Astro.props;

// global.css is inlined into every page (no render-blocking request before first paint).
// Its font URLs are relative to /assets/css/, so they are rewritten to absolute paths.
const GLOBAL_CSS = globalCssRaw.replaceAll('../fonts/', '/assets/fonts/');
const slug = slugFromPath(Astro.url.pathname);
const seo = !INTERNAL_PAGES.has(slug);
const url = cleanUrl(slug);
const image = ogImage(slug);
const jsonLd = seo ? structuredData(slug, title, description ?? '') : '';
---
<!doctype html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content={viewport}>
{themeColor && <meta name="theme-color" content={themeColor}>}
<title>{title}</title>
{description && <meta name="description" content={description}>}
{robots && <meta name="robots" content={robots}>}
<link rel="preload" as="font" type="font/woff2" href="/assets/fonts/alexandria-arabic.woff2" crossorigin>
{preloadImage && <link rel="preload" as="image" href={preloadImage.href} imagesrcset={preloadImage.srcset} imagesizes={preloadImage.sizes} type="image/avif" fetchpriority="high">}
{globalCssFirst && <style is:inline set:html={GLOBAL_CSS}></style>}
<slot name="head" />
{!globalCssFirst && <style is:inline set:html={GLOBAL_CSS}></style>}
{seo && (
  <>
    <link rel="canonical" href={url}>
    <meta property="og:type" content="website">
    <meta property="og:locale" content="ar_EG">
    <meta property="og:site_name" content={SITE_NAME}>
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:url" content={url}>
    <meta property="og:image" content={image}>
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content={title}>
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content={image}>
    <script type="application/ld+json" is:inline set:html={jsonLd}></script>
  </>
)}
</head>
<body>
<slot />
</body>
</html>
